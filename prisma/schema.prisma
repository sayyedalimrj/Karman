// Karman operational database schema (source of truth: design.md).
// All monetary fields use Decimal(18,4) — never Float/Int for currency.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  SYSTEM_ADMIN
  PROJECT_ADMIN
  EMPLOYER
  CONSULTANT
  CONTRACTOR
  FINANCIAL_CONTROLLER
  REVIEWER
  VIEWER
  SUPPORT_ADMIN
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WorkflowState {
  PROJECT_DRAFT
  PROJECT_ACTIVE
  DOCUMENT_DRAFT
  MEASUREMENT_IN_PROGRESS
  CONTRACTOR_INTERNAL_CHECK
  SUBMITTED_TO_CONSULTANT
  CONSULTANT_REVIEWING
  RETURNED_TO_CONTRACTOR
  CONSULTANT_APPROVED
  SUBMITTED_TO_EMPLOYER
  EMPLOYER_REVIEWING
  RETURNED_BY_EMPLOYER
  EMPLOYER_APPROVED
  DOCUMENT_LOCKED
  EXPORT_READY
  EXPORTED_TO_TAKSA
}

enum PartyType {
  EMPLOYER
  CONSULTANT
  CONTRACTOR
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  WORKFLOW_TRANSITION
  LOCK
  UNLOCK
  EXPORT
  IMPORT
}

enum TaksaImportStatus {
  NOT_IMPORTED
  PENDING
  IMPORTED
  FAILED
}

enum TaksaExportStatus {
  NOT_EXPORTED
  PENDING
  EXPORTED
  FAILED
}

// ---------- Core identity ----------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  isActive     Boolean  @default(true)
  systemRole   Role     @default(VIEWER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     ProjectMember[]
  auditLogs       AuditLog[]
  createdProjects Project[]       @relation("ProjectCreatedBy")
  createdCases    WorkflowCase[]  @relation("CaseCreatedBy")

  @@index([email])
  @@index([systemRole])
}

// ---------- Projects & membership ----------

model Project {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  description String?
  status      ProjectStatus @default(DRAFT)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  createdBy      User            @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  members        ProjectMember[]
  contracts      Contract[]
  parties        ProjectParty[]
  cases          WorkflowCase[]
  taksaArtifacts TaksaArtifact[]
  auditLogs      AuditLog[]

  @@index([status])
  @@index([createdById])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([role])
}

// ---------- Contracts & parties ----------

model Contract {
  id          String    @id @default(uuid())
  projectId   String
  code        String
  title       String
  // Decimal-safe monetary field — NEVER Float/Int.
  totalAmount Decimal   @db.Decimal(18, 4)
  currency    String    @default("IRR")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, code])
  @@index([projectId])
}

model ProjectParty {
  id         String    @id @default(uuid())
  projectId  String
  partyType  PartyType
  name       String
  nationalId String?
  contact    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([partyType])
}

// ---------- Workflow ----------

model WorkflowCase {
  id           String        @id @default(uuid())
  projectId    String
  title        String
  state        WorkflowState @default(DOCUMENT_DRAFT)
  isLocked     Boolean       @default(false)
  lockedAt     DateTime?
  revision     Int           @default(1)
  supersedesId String?
  createdById  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User           @relation("CaseCreatedBy", fields: [createdById], references: [id])
  supersedes WorkflowCase?  @relation("CaseRevision", fields: [supersedesId], references: [id])
  revisions  WorkflowCase[] @relation("CaseRevision")
  auditLogs  AuditLog[]

  @@index([projectId])
  @@index([state])
  @@index([isLocked])
}

// ---------- Audit (append-only) ----------

model AuditLog {
  id             String         @id @default(uuid())
  actorUserId    String
  projectId      String?
  workflowCaseId String?
  action         AuditAction
  entityType     String
  entityId       String
  fromState      WorkflowState?
  toState        WorkflowState?
  metadata       Json?
  createdAt      DateTime       @default(now())

  actor        User          @relation(fields: [actorUserId], references: [id])
  project      Project?      @relation(fields: [projectId], references: [id])
  workflowCase WorkflowCase? @relation(fields: [workflowCaseId], references: [id])

  @@index([actorUserId])
  @@index([projectId])
  @@index([workflowCaseId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------- Attachment (placeholder) ----------

model Attachment {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  fileName    String
  storageKey  String
  contentType String?
  byteSize    Int?
  checksum    String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
}

// ---------- Taksa compatibility (placeholders, shaped for round-trip) ----------

model TaksaArtifact {
  id           String            @id @default(uuid())
  projectId    String?
  sourceName   String
  importStatus TaksaImportStatus @default(NOT_IMPORTED)
  exportStatus TaksaExportStatus @default(NOT_EXPORTED)
  checksum     String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  project   Project?        @relation(fields: [projectId], references: [id])
  rawTables TaksaRawTable[]

  @@index([projectId])
  @@index([importStatus])
  @@index([exportStatus])
}

model TaksaRawTable {
  id           String   @id @default(uuid())
  artifactId   String
  rawTableName String // PRESERVE original Taksa table name verbatim
  tableOrder   Int // preserve original table ordering
  checksum     String?
  createdAt    DateTime @default(now())

  artifact TaksaArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  rawRows  TaksaRawRow[]

  @@unique([artifactId, rawTableName])
  @@index([artifactId])
}

model TaksaRawRow {
  id         String   @id @default(uuid())
  rawTableId String
  rowOrder   Int // PRESERVE original row order
  rawJson    Json // PRESERVE original raw row content verbatim
  patchJson  Json? // non-destructive overlay/edits
  checksum   String?
  createdAt  DateTime @default(now())

  rawTable TaksaRawTable @relation(fields: [rawTableId], references: [id], onDelete: Cascade)

  @@unique([rawTableId, rowOrder])
  @@index([rawTableId])
}


// ============================================================================
// Reference Master Data layer
// ----------------------------------------------------------------------------
// Taksa-derived data (Taksa DB, SQL scripts, SVZT/BRVT/PSNT, Excel templates,
// official PDFs, extracted research) is a FIRST-CLASS source / reference /
// master-data input — NOT ignored, and NOT the live runtime DB.
//
// PostgreSQL (the models below) remains the operational runtime database.
// Taksa sources flow through:
//   source → staging/extraction → raw preservation (TaksaArtifact/RawTable/Row)
//          → reference mapping layer (src/server/reference) → the normalized
//            Reference* tables below → calculations / reports / validation /
//            golden tests.
//
// HARD RULE: official values (شاخص / فهرست‌بها / ردیف / واحد / منبع / ضریب /
// کسورات / بخشنامه / تعدیل) are NEVER hard-coded constants. They are imported
// and mapped into these tables from real Taksa/official sources, with full
// provenance and an explicit mapping-status lifecycle. This schema is contracts
// + shape only; no official values are seeded here.
//
// All reference numeric values (unitPrice, indexValue, coefficientValue, rate,
// fixedValue, ...) are Decimal @db.Decimal(18, 4) — NEVER Float/Int/number.
// ============================================================================

// ---------- Reference enums ----------

enum ReferenceSourceType {
  TAKSA_DB
  TAKSA_SQL_SCRIPT
  SVZT
  BRVT
  PSNT
  EXCEL
  PDF_OFFICIAL_DOC
  MANUAL_VERIFIED
}

enum ReferenceMappingStatus {
  RAW
  MAPPED
  VERIFIED
  CONFLICT
  DEPRECATED
}

enum ReferenceBookType {
  PRICE_LIST
  INDEX
  RESOURCE
  CIRCULAR
  COEFFICIENT
  DEDUCTION
  OTHER
}

// ---------- Provenance roots ----------

model ReferenceSource {
  id                 String              @id @default(uuid())
  sourceType         ReferenceSourceType
  name               String
  // Provenance: the original Taksa artifact this source represents (verbatim).
  originalFileName   String?
  originalDbName     String?
  originalScriptName String?
  checksum           String?
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  importRuns ReferenceImportRun[]

  @@unique([sourceType, name])
  @@index([sourceType])
  @@index([checksum])
}

model ReferenceImportRun {
  id          String    @id @default(uuid())
  sourceId    String
  // Lifecycle status (e.g. STARTED, COMPLETED, FAILED) — free-form, not coupled
  // to the operational WorkflowState enum.
  status      String    @default("STARTED")
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  rowsRead    Int?
  rowsMapped  Int?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  source ReferenceSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([status])
}

// ---------- Normalized reference hierarchy (فهرست‌بها / منابع / شاخص ...) ----------

model ReferenceBook {
  id            String                 @id @default(uuid())
  bookType      ReferenceBookType
  code          String
  title         String
  effectiveYear Int
  // Provenance (indexed; links back to ReferenceSource / ReferenceImportRun).
  sourceId      String?
  importRunId   String?
  rawTableName  String?
  rawCode       String?
  checksum      String?
  mappingStatus ReferenceMappingStatus @default(RAW)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  chapters ReferenceChapter[]
  items    ReferenceItem[]

  @@unique([bookType, code, effectiveYear])
  @@index([sourceId])
  @@index([importRunId])
  @@index([mappingStatus])
  @@index([effectiveYear])
}

model ReferenceChapter {
  id            String                 @id @default(uuid())
  bookId        String
  code          String
  title         String
  order         Int
  // Provenance
  sourceId      String?
  importRunId   String?
  rawTableName  String?
  rawRowOrder   Int?
  rawCode       String?
  checksum      String?
  mappingStatus ReferenceMappingStatus @default(RAW)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  book  ReferenceBook   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  items ReferenceItem[]

  @@unique([bookId, code])
  @@index([bookId])
  @@index([sourceId])
  @@index([importRunId])
  @@index([mappingStatus])
}

model ReferenceUnit {
  id            String                 @id @default(uuid())
  code          String
  name          String
  // Provenance
  sourceId      String?
  importRunId   String?
  rawTableName  String?
  rawCode       String?
  checksum      String?
  mappingStatus ReferenceMappingStatus @default(RAW)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  items     ReferenceItem[]
  resources ReferenceResource[]

  @@unique([code])
  @@index([sourceId])
  @@index([importRunId])
  @@index([mappingStatus])
}

model ReferenceItem {
  id               String                 @id @default(uuid())
  bookId           String
  chapterId        String?
  itemCode         String
  shortDescription String
  fullDescription  String?
  unitId           String?
  // Reference numeric — Decimal-only, never Float/Int/number.
  unitPrice        Decimal                @db.Decimal(18, 4)
  effectiveYear    Int
  // Full source provenance
  sourceId         String?
  importRunId      String?
  rawTableName     String?
  rawCode          String?
  rawRowOrder      Int?
  rawJson          Json?
  checksum         String?
  mappingStatus    ReferenceMappingStatus @default(RAW)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  book    ReferenceBook    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter ReferenceChapter? @relation(fields: [chapterId], references: [id])
  unit    ReferenceUnit?   @relation(fields: [unitId], references: [id])

  @@unique([bookId, itemCode, effectiveYear])
  @@index([bookId])
  @@index([chapterId])
  @@index([unitId])
  @@index([itemCode])
  @@index([sourceId])
  @@index([importRunId])
  @@index([mappingStatus])
  @@index([effectiveYear])
}

model ReferenceResource {
  id            String                 @id @default(uuid())
  resourceCode  String
  name          String
  unitId        String?
  // Reference numeric — Decimal-only (optional until a value is mapped/verified).
  unitPrice     Decimal?               @db.Decimal(18, 4)
  effectiveYear Int
  // Provenance
  sourceId      String?
  importRunId   String?
  rawTableName  String?
  rawCode       String?
  rawRowOrder   Int?
  rawJson       Json?
  checksum      String?
  mappingStatus ReferenceMappingStatus @default(RAW)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  unit ReferenceUnit? @relation(fields: [unitId], references: [id])

  @@unique([resourceCode, effectiveYear])
  @@index([resourceCode])
  @@index([unitId])
  @@index([sourceId])
  @@index([importRunId])
  @@index([mappingStatus])
  @@index([effectiveYear])
}

model ReferenceIndexPeriod {
  id            String                 @id @default(uuid())
  // Optional links to the entity the index applies to (kept loose by design).
  bookId        String?
  chapterId     String?
  itemId        String?
  category      String?
  // Period descriptors — at least one of (year) or effectivePeriod is expected.
  year          Int?
  quarter       Int?
  month         Int?
  effectivePeriod String?
  // Reference numeric — Decimal-only.
  indexValue    Decimal                @db.Decimal(18, 4)
  // Provenance
  sourceId      String?
  importRunId   String?
  rawTableName  String?
  rawCode       String?
  rawRowOrder   Int?
  rawJson       Json?
  checksum      String?
  mappingStatus ReferenceMappingStatus @default(RAW)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([bookId])
  @@index([chapterId])
  @@index([itemId])
  @@index([category])
  @@index([year])
  @@index([sourceId])
  @@index([importRunId])
  @@index([mappingStatus])
}

model ReferenceCircular {
  id            String                 @id @default(uuid())
  circularNo    String
  title         String
  issuedAt      DateTime?
  effectiveDate DateTime?
  description   String?
  // Document provenance
  sourceId      String?
  importRunId   String?
  rawTableName  String?
  rawCode       String?
  checksum      String?
  mappingStatus ReferenceMappingStatus @default(RAW)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([circularNo])
  @@index([sourceId])
  @@index([importRunId])
  @@index([mappingStatus])
}

model ReferenceCoefficientRule {
  id               String                 @id @default(uuid())
  code             String
  title            String
  // Reference numeric — Decimal-only.
  coefficientValue Decimal                @db.Decimal(18, 4)
  // Applicability metadata (scope, conditions) — structured, no official values.
  applicability    Json?
  effectiveYear    Int?
  // Provenance
  sourceId         String?
  importRunId      String?
  rawTableName     String?
  rawCode          String?
  checksum         String?
  mappingStatus    ReferenceMappingStatus @default(RAW)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([code, effectiveYear])
  @@index([code])
  @@index([sourceId])
  @@index([importRunId])
  @@index([mappingStatus])
}

model ReferenceDeductionRule {
  id            String                 @id @default(uuid())
  code          String
  title         String
  // Reference numerics — Decimal-only. `rate` is a fraction (e.g. 0.0500),
  // `fixedValue` is an absolute amount; either/both may apply.
  rate          Decimal?               @db.Decimal(18, 4)
  fixedValue    Decimal?               @db.Decimal(18, 4)
  applicability Json?
  effectiveYear Int?
  // Provenance
  sourceId      String?
  importRunId   String?
  rawTableName  String?
  rawCode       String?
  checksum      String?
  mappingStatus ReferenceMappingStatus @default(RAW)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([code, effectiveYear])
  @@index([code])
  @@index([sourceId])
  @@index([importRunId])
  @@index([mappingStatus])
}

// ---------- The raw → normalized bridge ----------

model ReferenceMapping {
  id                   String                 @id @default(uuid())
  sourceType           ReferenceSourceType
  rawTableName         String
  rawRowId             String?
  rawRowOrder          Int?
  rawCode              String?
  // The normalized entity this raw source row was mapped to.
  normalizedEntityType String
  normalizedEntityId   String
  mappingStatus        ReferenceMappingStatus @default(RAW)
  checksum             String?
  notes                String?
  importRunId          String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([normalizedEntityType, normalizedEntityId])
  @@index([rawTableName, rawCode])
  @@index([sourceType])
  @@index([importRunId])
  @@index([mappingStatus])
}



// ============================================================================
// Taksa STAGING / ANALYSIS layer (Phase 2)
// ----------------------------------------------------------------------------
// Server-aware ingestion + analysis metadata for Taksa sources. These models
// store ONLY safe, non-sensitive metadata produced by the discovery/analysis
// CLIs (relative paths, checksums, detected types, structural mappings, UI
// labels, behavior hints). They NEVER store raw file content, official values,
// secrets, or connection strings.
//
// They are intentionally SEPARATE from the raw-preservation models
// (TaksaArtifact/RawTable/RawRow) and the Reference* master-data models — this
// is analyzer/staging metadata, not preserved rows and not normalized business
// data. The website reads these models to render the Taksa analysis UI without
// ever scanning raw files at request time.
// ============================================================================

model TaksaDiscoveredFile {
  id                   String   @id @default(uuid())
  relativePath         String // SAFE relative path from the data root (never absolute)
  fileName             String
  extension            String
  sourceType           String
  sourceFamily         String?
  category             String
  sizeBytes            Int
  checksum             String
  modifiedAt           DateTime?
  supportedForAnalysis Boolean  @default(false)
  supportedForIngestion Boolean @default(false)
  status               String   @default("DISCOVERED")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([checksum, relativePath])
  @@index([sourceType])
  @@index([category])
  @@index([status])
}

model TaksaAnalysisRun {
  id           String    @id @default(uuid())
  analyzerType String
  status       String    @default("STARTED")
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  totalFiles   Int       @default(0)
  successCount Int       @default(0)
  warningCount Int       @default(0)
  errorCount   Int       @default(0)
  outputDir    String?
  summaryJson  Json?
  createdById  String?
  createdAt    DateTime  @default(now())

  detectedEntities  TaksaDetectedEntity[]
  scriptXmlMappings TaksaScriptXmlMapping[]
  uiLabels          TaksaUiLabel[]
  behaviorHints     TaksaBehaviorHint[]

  @@index([analyzerType])
  @@index([status])
  @@index([createdById])
  @@index([startedAt])
}

model TaksaDetectedEntity {
  id         String   @id @default(uuid())
  runId      String
  entityType String
  sourceType String
  sourceFile String
  family     String?
  name       String
  parentName String?
  metadata   Json?
  // Non-money confidence score (Float by design; check:decimal only constrains
  // Decimal/money-named fields — `confidence` is neither).
  confidence Float?
  createdAt  DateTime @default(now())

  run TaksaAnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([entityType])
  @@index([sourceType])
  @@index([name])
}

model TaksaScriptXmlMapping {
  id            String   @id @default(uuid())
  runId         String
  procedureName String?
  xmlPath       String?
  targetTable   String
  columns       Json?
  confidence    Float?
  createdAt     DateTime @default(now())

  run TaksaAnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([targetTable])
}

model TaksaUiLabel {
  id               String   @id @default(uuid())
  runId            String
  sourceFile       String
  label            String
  dataPropertyName String?
  formName         String?
  gridName         String?
  metadata         Json?
  createdAt        DateTime @default(now())

  run TaksaAnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([sourceFile])
}

model TaksaBehaviorHint {
  id         String   @id @default(uuid())
  runId      String
  sourceFile String
  topic      String
  text       String
  metadata   Json?
  createdAt  DateTime @default(now())

  run TaksaAnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([topic])
}
